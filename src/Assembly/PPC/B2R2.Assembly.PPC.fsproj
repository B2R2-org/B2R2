<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageIcon>b2r2-240x240.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>B2R2 PPC assembly library.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ParserHelper.fs" />
    <Compile Include="AsmField.fs" />
    <Compile Include="AsmOpcode.fs" />
    <Compile Include="AsmFloat.fs" />
    <Compile Include="AsmVector.fs" />
    <Compile Include="AsmMain.fs" />
    <Compile Include="Assembler.fs" />
    <None Include="..\..\..\LICENSE.md" Pack="true" PackagePath="" />
    <None Include="..\..\..\assets\b2r2-240x240.png" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FParsec" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FrontEnd\PPC\B2R2.FrontEnd.PPC.fsproj" />
    <ProjectReference Include="..\BinLowerer\B2R2.Assembly.BinLowerer.fsproj" />
  </ItemGroup>

</Project>
