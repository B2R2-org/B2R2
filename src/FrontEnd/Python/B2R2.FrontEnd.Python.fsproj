<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageIcon>b2r2-240x240.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>B2R2 Python frontend.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Register.fs" />
    <Compile Include="RegisterFactory.fs" />
    <Compile Include="Operands.fs" />
    <Compile Include="Instruction.fs" />
    <Compile Include="Disasm.fs" />
    <Compile Include="LifterHelpers.fs" />
    <!-- One directory per Python version. Everything that depends on a
         version's own opcode numbering lives in exactly one of them, so two
         people adding two versions never edit the same file. -->
    <Compile Include="Python305\Opcode.fs" />
    <Compile Include="Python305\Semantics.fs" />
    <Compile Include="Python305\Disasm.fs" />
    <Compile Include="Python305\Lifter.fs" />
    <Compile Include="Python305\Parsing.fs" />
    <Compile Include="Python306\Opcode.fs" />
    <Compile Include="Python306\Semantics.fs" />
    <Compile Include="Python306\Disasm.fs" />
    <Compile Include="Python306\Lifter.fs" />
    <Compile Include="Python306\Parsing.fs" />
    <Compile Include="Python307\Opcode.fs" />
    <Compile Include="Python307\Semantics.fs" />
    <Compile Include="Python307\Disasm.fs" />
    <Compile Include="Python307\Lifter.fs" />
    <Compile Include="Python307\Parsing.fs" />
    <Compile Include="Python308\Opcode.fs" />
    <Compile Include="Python308\Semantics.fs" />
    <Compile Include="Python308\Disasm.fs" />
    <Compile Include="Python308\Lifter.fs" />
    <Compile Include="Python308\Parsing.fs" />
    <Compile Include="Python309\Opcode.fs" />
    <Compile Include="Python309\Semantics.fs" />
    <Compile Include="Python309\Disasm.fs" />
    <Compile Include="Python309\Lifter.fs" />
    <Compile Include="Python309\Parsing.fs" />
    <Compile Include="Python310\Opcode.fs" />
    <Compile Include="Python310\Semantics.fs" />
    <Compile Include="Python310\Disasm.fs" />
    <Compile Include="Python310\Lifter.fs" />
    <Compile Include="Python310\Parsing.fs" />
    <Compile Include="Python311\Opcode.fs" />
    <Compile Include="Python311\Semantics.fs" />
    <Compile Include="Python311\Disasm.fs" />
    <Compile Include="Python311\Lifter.fs" />
    <Compile Include="Python311\Parsing.fs" />
    <Compile Include="Python312\Opcode.fs" />
    <Compile Include="Python312\Semantics.fs" />
    <Compile Include="Python312\Disasm.fs" />
    <Compile Include="Python312\Lifter.fs" />
    <Compile Include="Python312\Parsing.fs" />
    <Compile Include="Python313\Opcode.fs" />
    <Compile Include="Python313\Semantics.fs" />
    <Compile Include="Python313\Disasm.fs" />
    <Compile Include="Python313\Lifter.fs" />
    <Compile Include="Python313\Parsing.fs" />
    <Compile Include="Python314\Opcode.fs" />
    <Compile Include="Python314\Semantics.fs" />
    <Compile Include="Python314\Disasm.fs" />
    <Compile Include="Python314\Lifter.fs" />
    <Compile Include="Python314\Parsing.fs" />
    <Compile Include="Python315\Opcode.fs" />
    <Compile Include="Python315\Semantics.fs" />
    <Compile Include="Python315\Disasm.fs" />
    <Compile Include="Python315\Lifter.fs" />
    <Compile Include="Python315\Parsing.fs" />
    <Compile Include="Parser.fs" />
    <None Include="..\..\..\LICENSE.md" Pack="true" PackagePath="" />
    <None Include="..\..\..\assets\b2r2-240x240.png" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\B2R2.Core.fsproj" />
    <ProjectReference Include="..\..\BinIR\B2R2.BinIR.fsproj" />
    <ProjectReference Include="..\BinFile\B2R2.FrontEnd.BinFile.fsproj" />
    <ProjectReference Include="..\BinLifter\B2R2.FrontEnd.BinLifter.fsproj" />
  </ItemGroup>
</Project>
