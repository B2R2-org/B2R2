<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>B2R2 frontend registers.</Description>
    <OtherFlags>$(OtherFlags)--warnon:3390</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ARM32.fs" />
    <Compile Include="ARM64.fs" />
    <Compile Include="AVR.fs" />
    <Compile Include="Intel.fs" />
    <Compile Include="M68K.fs" />
    <Compile Include="MIPS.fs" />
    <Compile Include="PARISC.fs" />
    <Compile Include="PPC.fs" />
    <Compile Include="RISCV64.fs" />
    <Compile Include="S390.fs" />
    <Compile Include="SH4.fs" />
    <Compile Include="SPARC.fs" />
    <Compile Include="TMS320C6000.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\B2R2.Core.fsproj" />
  </ItemGroup>

</Project>
