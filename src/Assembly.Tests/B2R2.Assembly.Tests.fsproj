<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The sweeps walk the encoding space of every architecture the assemblers
       cover, which takes longer than the whole of the rest of the suite put
       together, so they are left out unless they are asked for by name:

         dotnet test -p:FullTest=true

       Nothing else is left out, and the sweeps themselves are still reachable
       on their own by filtering on "TestCategory=Sweep". -->
  <PropertyGroup Condition="'$(FullTest)' != 'true'">
    <VSTestTestCaseFilter>TestCategory!=Sweep</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MSTestSettings.fs" />
    <Compile Include="IntelTests.fs" />
    <Compile Include="IntelSweep.fs" />
    <Compile Include="IntelRoundTripTests.fs" />
    <Compile Include="IntelEncodingTests.fs" />
    <Compile Include="ARM32Sweep.fs" />
    <Compile Include="ARM32RoundTripTests.fs" />
    <Compile Include="ARM32EncodingTests.fs" />
    <Compile Include="ARM64Sweep.fs" />
    <Compile Include="ARM64RoundTripTests.fs" />
    <Compile Include="MIPSSweep.fs" />
    <Compile Include="MIPSRoundTripTests.fs" />
    <Compile Include="PARISCSweep.fs" />
    <Compile Include="PARISCRoundTripTests.fs" />
    <Compile Include="PPCSweep.fs" />
    <Compile Include="PPCRoundTripTests.fs" />
    <Compile Include="RISCV64Sweep.fs" />
    <Compile Include="RISCV64RoundTripTests.fs" />
    <Compile Include="S390Sweep.fs" />
    <Compile Include="S390RoundTripTests.fs" />
    <Compile Include="SPARCSweep.fs" />
    <Compile Include="SPARCRoundTripTests.fs" />
    <Compile Include="SH4Sweep.fs" />
    <Compile Include="SH4RoundTripTests.fs" />
    <Compile Include="AVRSweep.fs" />
    <Compile Include="AVRRoundTripTests.fs" />
    <Compile Include="EVMSweep.fs" />
    <Compile Include="EVMRoundTripTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assembly\Intel\B2R2.Assembly.Intel.fsproj" />
    <ProjectReference Include="..\Assembly\ARM32\B2R2.Assembly.ARM32.fsproj" />
    <ProjectReference Include="..\Assembly\ARM64\B2R2.Assembly.ARM64.fsproj" />
    <ProjectReference Include="..\Assembly\MIPS\B2R2.Assembly.MIPS.fsproj" />
    <ProjectReference
      Include="..\Assembly\PARISC\B2R2.Assembly.PARISC.fsproj" />
    <ProjectReference Include="..\Assembly\PPC\B2R2.Assembly.PPC.fsproj" />
    <ProjectReference
      Include="..\Assembly\RISCV64\B2R2.Assembly.RISCV64.fsproj" />
    <ProjectReference Include="..\Assembly\S390\B2R2.Assembly.S390.fsproj" />
    <ProjectReference Include="..\Assembly\SPARC\B2R2.Assembly.SPARC.fsproj" />
    <ProjectReference Include="..\Assembly\SH4\B2R2.Assembly.SH4.fsproj" />
    <ProjectReference Include="..\Assembly\AVR\B2R2.Assembly.AVR.fsproj" />
    <ProjectReference Include="..\Assembly\EVM\B2R2.Assembly.EVM.fsproj" />
    <ProjectReference Include="..\Assembly\API\B2R2.Assembly.API.fsproj" />
    <ProjectReference Include="..\FrontEnd\Intel\B2R2.FrontEnd.Intel.fsproj" />
    <ProjectReference Include="..\FrontEnd\ARM32\B2R2.FrontEnd.ARM32.fsproj" />
    <ProjectReference Include="..\FrontEnd\ARM64\B2R2.FrontEnd.ARM64.fsproj" />
    <ProjectReference Include="..\FrontEnd\MIPS\B2R2.FrontEnd.MIPS.fsproj" />
    <ProjectReference
      Include="..\FrontEnd\PARISC\B2R2.FrontEnd.PARISC.fsproj" />
    <ProjectReference Include="..\FrontEnd\PPC\B2R2.FrontEnd.PPC.fsproj" />
    <ProjectReference
      Include="..\FrontEnd\RISCV64\B2R2.FrontEnd.RISCV64.fsproj" />
    <ProjectReference Include="..\FrontEnd\S390\B2R2.FrontEnd.S390.fsproj" />
    <ProjectReference Include="..\FrontEnd\SPARC\B2R2.FrontEnd.SPARC.fsproj" />
    <ProjectReference Include="..\FrontEnd\SH4\B2R2.FrontEnd.SH4.fsproj" />
    <ProjectReference Include="..\FrontEnd\AVR\B2R2.FrontEnd.AVR.fsproj" />
    <ProjectReference Include="..\FrontEnd\EVM\B2R2.FrontEnd.EVM.fsproj" />
    <ProjectReference
      Include="..\FrontEnd\BinLifter\B2R2.FrontEnd.BinLifter.fsproj" />
  </ItemGroup>

</Project>
