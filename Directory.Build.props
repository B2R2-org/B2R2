<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Product>B2R2</Product>
    <Authors>SoftSec Lab. @ KAIST</Authors>
    <Company>SoftSec Lab. @ KAIST</Company>
    <VersionPrefix>0.10.1</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <Copyright>Copyright (c) SoftSec Lab. @ KAIST, since 2016</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryUrl>https://github.com/B2R2-org/B2R2</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EnableSourceLink Condition="'$(ContinuousIntegrationBuild)' != 'true'">false</EnableSourceLink>
    <IncludeSourceRevisionInInformationalVersion Condition="'$(ContinuousIntegrationBuild)' != 'true'">false</IncludeSourceRevisionInInformationalVersion>
    <PackageProjectUrl>https://b2r2.org/B2R2</PackageProjectUrl>
    <PackageTags>Binary;Disassembly;Assembly;CFG;Reversing;Binary Analysis;x86;AARCH64;ARM;MIPS;AVR;PPC;EVM;ELF;Mach-O;PE</PackageTags>
    <FsDocsLogoSource>https://b2r2.org/images/b2r2-240x240.png</FsDocsLogoSource>
    <FsDocsReleaseNotesLink>https://github.com/B2R2-org/B2R2/blob/main/CHANGELOG.md</FsDocsReleaseNotesLink>

    <!-- Pin the implicit FSharp.Core reference instead of taking whatever the
         installed SDK happens to ship, so every environment resolves the same
         version. Must stay at or above what our own packages require. -->
    <FSharpCoreImplicitPackageVersion>11.0.101</FSharpCoreImplicitPackageVersion>

    <WarnOn>$(WarnOn);3389</WarnOn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <CustomPropTarget>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</CustomPropTarget>
  </PropertyGroup>

  <Import Project="$(CustomPropTarget)" Condition="Exists('$(CustomPropTarget)')" />

  <!-- Hash consing of LowUIR nodes is compiled in with the HASHCONS symbol;
       build with -p:HashCons=true to get it. The symbol is appended rather
       than handed over as -p:DefineConstants, which would replace DEBUG and
       TRACE instead of joining them, and it is appended after the import
       above, so that a Directory.Build.props further up cannot drop it. -->
  <PropertyGroup Condition="'$(HashCons)' == 'true'">
    <DefineConstants>$(DefineConstants);HASHCONS</DefineConstants>
  </PropertyGroup>
</Project>
