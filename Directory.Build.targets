<Project>
  <!-- Packaging assets shared by every packable project: the repository-wide
       license and icon, plus the project's own README. Imported after each
       project file so that IsPackable is already known here. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <PackageLicenseFile Condition="'$(PackageLicenseFile)' == ''">LICENSE.md</PackageLicenseFile>
    <PackageIcon Condition="'$(PackageIcon)' == ''">b2r2-240x240.png</PackageIcon>
    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == ''">README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE.md" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)assets/b2r2-240x240.png" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
