<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>IntelParserGen</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <B2R2Root Condition="'$(B2R2Root)'==''">$(MSBuildThisFileDirectory)../..</B2R2Root>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(B2R2Root)/src/FrontEnd/Intel/B2R2.FrontEnd.Intel.fsproj" />
  </ItemGroup>
</Project>
